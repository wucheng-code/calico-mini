/**pages/history/history.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbfbfa;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  width: 100%;
  box-sizing: border-box;
  padding: 20px 16px 40px;
}

.hint,
.empty {
  padding: 40px 20px;
  text-align: center;
  color: #9ca3af;
  font-size: 14px;
}
.error {
  padding: 16px;
  background: #fffafa;
  border: 1px solid #f3d2d2;
  border-radius: 12px;
  font-size: 13px;
  color: #b91c1c;
  word-break: break-all;
}

.stats {
  display: flex;
  background: #fff;
  border: 1px solid #eeedea;
  border-radius: 14px;
  padding: 16px 0;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 19px;
  font-weight: 500;
  color: #1f2328;
}
.stat-label {
  margin-top: 3px;
  font-size: 11px;
  color: #9ca3af;
}

.chart {
  margin-top: 24px;
  display: flex;
  align-items: flex-end;
  height: 200px;
  padding: 0 4px;
}
.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.col-value {
  font-size: 10px;
  color: #b8b8b3;
  height: 14px;
  line-height: 14px;
}
.bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 18px;
  background: #c7d7f5;
  border-radius: 5px 5px 2px 2px;
}
.bar.today {
  background: #2563eb;
}
.col-label {
  margin-top: 8px;
  font-size: 11px;
  color: #9ca3af;
}
.col-label.today-text {
  color: #2563eb;
  font-weight: 500;
}
