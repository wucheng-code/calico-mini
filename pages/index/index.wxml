<!--index.wxml-->
<navigation-bar title="Calico 咔嚓猫" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">

    <view class="hint" wx:if="{{loading}}">正在读取今日记录…</view>

    <view class="error" wx:elif="{{errMsg}}">
      <view class="error-title">读取失败</view>
      <view class="error-msg">{{errMsg}}</view>
      <view class="error-tip">按顺序检查：</view>
      <view class="error-tip">1. 云开发是否已开通（环境 prod）</view>
      <view class="error-tip">2. 集合 records 是否已创建</view>
      <view class="error-tip">3. 集合权限是否为「仅创建者可读写」</view>
    </view>

    <block wx:else>

      <!-- 今日概览 -->
      <view class="summary">
        <view class="summary-top">
          <view>
            <view class="summary-date">{{date}}</view>
            <view class="summary-label">今日摄入</view>
          </view>
          <view class="summary-num">
            <text class="big">{{total}}</text>
            <text class="small"> / {{target}} kcal</text>
          </view>
        </view>

        <view class="links">
          <text class="link-item" bindtap="goHistory">近 7 天趋势 ›</text>
          <text class="link-item" bindtap="goProfile">设置每日目标 ›</text>
        </view>

        <view class="bar">
          <view class="bar-fill" style="width: {{percent}}%"></view>
        </view>

        <view class="macros">
          <view class="macro">
            <view class="macro-num">{{protein}}</view>
            <view class="macro-label">蛋白质 g</view>
          </view>
          <view class="macro">
            <view class="macro-num">{{fat}}</view>
            <view class="macro-label">脂肪 g</view>
          </view>
          <view class="macro">
            <view class="macro-num">{{carb}}</view>
            <view class="macro-label">碳水 g</view>
          </view>
        </view>

        <view class="meow">
          <view class="meow-face">安</view>
          <view class="meow-text">{{homeQuip}}</view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty" wx:if="{{isEmpty}}">今天还没记录，点下面按钮开始</view>

      <!-- 按餐次分组 -->
      <view class="section" wx:for="{{sections}}" wx:key="type" wx:for-item="sec">
        <view class="section-head">
          <text class="section-title">{{sec.label}}</text>
          <text class="section-sub">{{sec.subtotal}} kcal</text>
        </view>
        <view class="item" wx:for="{{sec.items}}" wx:key="_id" wx:for-item="food">
          <view class="item-left">
            <view class="name">{{food.foodName}}</view>
            <view class="cat">{{food.grams}} g</view>
          </view>
          <view class="kcal">{{food.calorie}} kcal</view>
        </view>
      </view>

      <view class="entry" bindtap="goSearch">
        <text class="entry-text">+ 记录这一顿</text>
      </view>

      <view class="dev-link" wx:if="{{isDev}}" bindtap="goDebug">▶ 跑一遍 JS 四道题</view>

    </block>

  </view>
</scroll-view>
