/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbfbfa;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  width: 100%;
  box-sizing: border-box;
  padding: 16px 16px 40px;
}

.hint,
.empty {
  padding: 48px 20px;
  text-align: center;
  color: #9ca3af;
  font-size: 14px;
}

.error {
  padding: 20px;
  background: #fffafa;
  border: 1px solid #f3d2d2;
  border-radius: 12px;
}
.error-title {
  font-size: 15px;
  font-weight: 600;
  color: #b91c1c;
  margin-bottom: 8px;
}
.error-msg {
  font-size: 13px;
  color: #7f1d1d;
  margin-bottom: 12px;
  word-break: break-all;
}
.error-tip {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.9;
}

.summary {
  background: #fff;
  border: 1px solid #eeedea;
  border-radius: 16px;
  padding: 18px;
}
.summary-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.summary-date {
  font-size: 12px;
  color: #b8b8b3;
}
.summary-label {
  font-size: 13px;
  color: #6b7280;
  margin-top: 4px;
}
.summary-num {
  display: flex;
  align-items: baseline;
}
.big {
  font-size: 30px;
  font-weight: 500;
  color: #1f2328;
  line-height: 1;
}
.small {
  font-size: 13px;
  color: #9ca3af;
}

.bar {
  margin-top: 16px;
  height: 8px;
  background: #f0efeb;
  border-radius: 4px;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #2563eb;
  border-radius: 4px;
  transition: width 0.3s;
}

.macros {
  margin-top: 18px;
  display: flex;
}
.macro {
  flex: 1;
  text-align: center;
}
.macro-num {
  font-size: 17px;
  font-weight: 500;
  color: #1f2328;
}
.macro-label {
  font-size: 11px;
  color: #9ca3af;
  margin-top: 2px;
}

.meow {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed #eeedea;
  display: flex;
  align-items: center;
}
.meow-face {
  flex: none;
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background: #f5c4b3;
  color: #712b13;
  font-size: 13px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.meow-text {
  margin-left: 10px;
  font-size: 13px;
  color: #6b7280;
  line-height: 1.5;
}

.section {
  margin-top: 22px;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
}
.section-title {
  font-size: 14px;
  font-weight: 500;
  color: #374151;
}
.section-sub {
  font-size: 12px;
  color: #9ca3af;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  margin-bottom: 8px;
  background: #fff;
  border: 1px solid #eeedea;
  border-radius: 12px;
}
.item-left {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: 14px;
  font-weight: 500;
  color: #1f2328;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cat {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 2px;
}
.kcal {
  flex: none;
  margin-left: 12px;
  white-space: nowrap;
  font-size: 13px;
  color: #d97706;
  font-weight: 500;
}

.entry {
  margin-top: 20px;
  padding: 14px;
  text-align: center;
  background: #2563eb;
  border-radius: 12px;
}
.entry-text {
  font-size: 15px;
  font-weight: 500;
  color: #fff;
}

.dev-link {
  margin-top: 24px;
  padding: 12px;
  text-align: center;
  font-size: 13px;
  color: #2563eb;
  background: #f7fafe;
  border: 1px dashed #d8e6f8;
  border-radius: 10px;
}
