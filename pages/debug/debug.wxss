/**pages/debug/debug.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbfbfa;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  padding: 16px 16px 60px;
}
.tip {
  font-size: 12px;
  color: #9ca3af;
  margin-bottom: 12px;
  line-height: 1.7;
}
.line {
  font-family: "SF Mono", Consolas, monospace;
  font-size: 12px;
  line-height: 1.9;
  color: #1f2328;
  word-break: break-all;
}
