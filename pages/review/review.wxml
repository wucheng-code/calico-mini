<!--pages/review/review.wxml-->
<navigation-bar title="安安说" back="{{false}}" color="black" background="#FBFBFA"></navigation-bar>

<view class="page">

  <view class="cat">
    <view class="cat-face">安</view>
    <view class="cat-name">安安</view>
  </view>

  <view class="bubble">
    <text class="quip">{{quip}}</text>
  </view>

  <view class="summary">
    <text class="summary-name">{{name}}</text>
    <text class="summary-line">{{grams}} g · {{calories}} kcal</text>
  </view>

  <view class="done" bindtap="done">知道了</view>

</view>
